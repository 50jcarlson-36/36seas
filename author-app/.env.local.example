# Supabase (36 Seas Publishing project)
NEXT_PUBLIC_SUPABASE_URL=https://ijffyuxvsrvuwruwtdlm.supabase.co
# Use the current Supabase publishable key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=  # from Supabase dashboard > Project Settings > API (server-only, never expose to client)

# AI editorial review
ANTHROPIC_API_KEY=          # from console.anthropic.com

# Optional: real cover art generation (falls back to built-in generated cover art if unset)
IMAGE_GEN_PROVIDER=         # optional: OpenAI is selected automatically when OPENAI_API_KEY is present
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_STORY_MODEL=gpt-5.6-terra
OPENAI_ORIGINALITY_MODEL=gpt-5.6-terra
OPENAI_ORIGINALITY_RISK_THRESHOLD=35
OWNER_EMAILS=50jcarlson@gmail.com
STABILITY_API_KEY=          # console.stability.ai — used when IMAGE_GEN_PROVIDER=stability
STABILITY_MODEL=            # "core" (default) | "sd3.5-large" | "ultra"
REPLICATE_API_TOKEN=        # replicate.com/account/api-tokens — used when IMAGE_GEN_PROVIDER=replicate
REPLICATE_MODEL_VERSION=    # a specific pinned model version id, e.g. an SDXL or Flux version on Replicate
# Note: Midjourney has no official public API, so it isn't offered as a provider here.

# Stripe (server-only values must also be configured in Vercel; never commit real keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Membership recurring Prices. Annual totals are exactly 10% below twelve monthly payments.
STRIPE_PRICE_STARTER_MONTHLY=    # $10/month
STRIPE_PRICE_STARTER_ANNUAL=     # $108/year
STRIPE_PRICE_AUTHOR_MONTHLY=     # $20/month
STRIPE_PRICE_AUTHOR_ANNUAL=      # $216/year
STRIPE_PRICE_PRO_MONTHLY=        # $29/month
STRIPE_PRICE_PRO_ANNUAL=         # $313.20/year
STRIPE_PRICE_PUBLISHER_MONTHLY=  # $80/month
STRIPE_PRICE_PUBLISHER_ANNUAL=   # $864/year

# Human manuscript evaluation (one-time Prices, up to 80,000 words)
STRIPE_PRICE_HUMAN_EVALUATION=            # $899 public/Free rate
STRIPE_PRICE_HUMAN_EVALUATION_STARTER=    # $849
STRIPE_PRICE_HUMAN_EVALUATION_AUTHOR=     # $799
STRIPE_PRICE_HUMAN_EVALUATION_PRO=        # $719
STRIPE_PRICE_HUMAN_EVALUATION_PUBLISHER=  # $629

# Publication-readiness review one-time Prices. Set your list amount in Stripe,
# then create tier Prices at 10%, 15%, 20%, and 30% below it.
STRIPE_PRICE_EXPERT_PACKAGE=
STRIPE_PRICE_EXPERT_PACKAGE_STARTER=
STRIPE_PRICE_EXPERT_PACKAGE_AUTHOR=
STRIPE_PRICE_EXPERT_PACKAGE_PRO=
STRIPE_PRICE_EXPERT_PACKAGE_PUBLISHER=

# Email (Resend) — powers team workspace invites and admin review-decision emails.
# Without this set, invites/notifications still work in-app, they just don't email anyone.
# 36seas.com is already added and VERIFIED in Resend, so this only needs your API key.
RESEND_API_KEY=              # resend.com/api-keys — paste the value here (Resend only shows it once at creation, there's no way to fetch it back via API)
RESEND_FROM_EMAIL=36Seas Publishing <notifications@36seas.com>
SERVICES_INBOX_EMAIL=notifications@36seas.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Per-chapter first-pass originality risk reviews use OPENAI_API_KEY. This is an
# AI risk assessment, not a web/database plagiarism match. Originality.ai will
# replace this adapter when its production API is connected.

# Premium audiobook adapter. Keep commercial approval false until 36Seas has a written
# API/commercial-distribution agreement with the selected narration provider.
TYPECAST_API_TOKEN=
TYPECAST_TTS_ENDPOINT=
TYPECAST_COMMERCIAL_REDISTRIBUTION_APPROVED=false
